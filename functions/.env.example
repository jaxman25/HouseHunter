# Copy to functions/.env for local emulation, or set these in the deployed
# Firebase Functions environment (`firebase functions:secrets:set`, or the
# .env.<project> file used by `firebase deploy`).

# Resend API key — https://resend.com/api-keys (required to send email)
RESEND_API_KEY=

# Verified sender shown as the From address.
# Must be a domain you verified in Resend.
NOTIFICATION_FROM_EMAIL=House Hunter <no-reply@your-domain.com>

# Comma-separated inbox(es) that receive security alerts (on-call owner).
# Used when an alert doc does not carry its own recipientEmails.
ADMIN_ALERT_EMAILS=oncall@your-domain.com
