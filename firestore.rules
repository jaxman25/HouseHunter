rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ──────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/admin/roles/$(request.auth.uid));
    }

    // Suspended accounts may keep reading their own data (GDPR) but cannot
    // create listings, conversations, messages, or notifications.
    function isSuspended() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.suspended == true;
    }

    function isParticipant(userIds) {
      return isAuthenticated() && request.auth.uid in userIds;
    }

    function isPropertyOwner(propertyId) {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/properties/$(propertyId)).data.userId == request.auth.uid;
    }

    function userDataIsValid() {
      return      request.resource.data.keys().hasAll([
        'uid', 'email', 'displayName', 'phoneNumber', 'photoURL',
        'bio', 'role', 'favorites', 'createdAt', 'updatedAt'
      ]) &&
      request.resource.data.email is string &&
      request.resource.data.displayName is string &&
      request.resource.data.role in ['buyer', 'seller', 'agent'];
    }

    function propertyDataIsValid() {
      return request.resource.data.keys().hasAll([
        'title', 'description', 'price', 'listingType', 'propertyType',
        'status', 'address', 'city', 'state', 'zipCode', 'country',
        'latitude', 'longitude', 'bedrooms', 'bathrooms', 'area',
        'areaUnit', 'yearBuilt', 'images', 'features', 'amenities',
        'userId', 'userName', 'userPhoto', 'userPhone',
        'views', 'inquiries', 'createdAt', 'updatedAt',
        'archived', 'contactEnabled'
      ]) &&
      request.resource.data.listingType in ['sale', 'rent'] &&
      request.resource.data.propertyType in [
        'house', 'apartment', 'condo', 'townhouse', 'land', 'commercial'
      ] &&
      // New listings always start Active and unarchived; owners move them
      // through the deal lifecycle via updates (propertyEditFieldsAreValid).
      request.resource.data.status == 'active' &&
      request.resource.data.archived == false &&
      request.resource.data.contactEnabled is bool &&
      request.resource.data.images is list;
    }

    function propertyEditFieldsAreValid() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'title', 'description', 'price', 'listingType', 'propertyType',
        'status', 'address', 'city', 'state', 'zipCode', 'country',
        'latitude', 'longitude', 'bedrooms', 'bathrooms', 'area',
        'areaUnit', 'yearBuilt', 'images', 'features', 'amenities',
        'views', 'inquiries', 'version', 'soldDate', 'pendingDate',
        'contactEnabled', 'archived', 'archivedAt', 'archiveReason',
        'expirationDate', 'updatedAt'
      ]);
    }

    // Optimistic locking: the client must bump `version` by exactly 1 from the
    // version it read. Docs created before versioning (no `version` field) are
    // treated as version 0, so their first edit writes version 1.
    function versionBumpedExactlyOnce() {
      return !('version' in resource.data)
        ? request.resource.data.version == 1
        : request.resource.data.version == resource.data.version + 1;
    }

    // ─── Rate limiting ─────────────────────────────────────────
    // Per-user write budget: max WRITE_LIMIT writes per wall-clock minute.
    // Every rate-limited write MUST be accompanied, in the same batch, by a
    // write to counters/{uid} shaped { minute: <epochMinute>, writes: <int> }.
    // The client bumps it with merge + increment(1). See
    // src/services/propertyService.ts (withWriteCount) for the client side.
    function writeBudgetRef() {
      return /databases/$(database)/documents/counters/$(request.auth.uid);
    }

    // Enforces (rules functions are expression-only — `let` bindings followed
    // by a single `return`, no if/else statements):
    //  - the batch writes counters/{uid} (so the after-state below exists),
    //  - the running count stays in [1, WRITE_LIMIT],
    //  - the first counter ever starts at 1,
    //  - same-minute writes increment the count by exactly 1, and
    //  - a new minute bucket starts fresh (any rollover count <= limit is OK).
    // The client writes an integer minute bucket (Math.floor(epochMs/60000));
    // comparing client-written minutes (before vs after) is exact, unlike
    // deriving the bucket from request.time (microsecond precision).
    function withinWriteLimit() {
      let after = getAfter(writeBudgetRef());
      let before = get(writeBudgetRef());
      return after.data.writes >= 1
          && after.data.writes <= 100
          && (!exists(writeBudgetRef())
            // First counter ever — must start at 1.
            ? after.data.writes == 1
            // Rolled into a new minute — client rewrote the bucket, so any
            // count up to the limit is fine.
            : before.data.minute != after.data.minute
              // Same minute — must be a clean +1 (increments serialize).
              || after.data.writes == before.data.writes + 1);
    }

    // ═══════════════════════════════════════════════════════════
    // COUNTERS COLLECTION (rate limiting bookkeeping)
    // ═══════════════════════════════════════════════════════════
    match /counters/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ═══════════════════════════════════════════════════════════
    // HEALTH CHECK COLLECTION (empty; used to probe connectivity)
    // ═══════════════════════════════════════════════════════════
    match /healthcheck/{doc} {
      allow read: if isAuthenticated();
    }

    // ═══════════════════════════════════════════════════════════
    // USERS COLLECTION
    // ═══════════════════════════════════════════════════════════
    match /users/{userId} {
      // Anyone authenticated can read any user profile (for chat, listings, etc.)
      allow read: if isAuthenticated();

      // Users can only create their own profile with correct doc ID
      allow create: if isOwner(userId) && userDataIsValid();

      // Users can only update their own profile (admins may suspend via the
      // dedicated suspend fields — see users/update allowlist).
      allow update: if isOwner(userId) && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'phoneNumber', 'photoURL', 'bio', 'role',
          'favorites', 'termsAcceptedAt', 'termsAcceptedVersion',
          'updatedAt'
        ])
      ) || (isAdmin() && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'suspended', 'suspensionReason', 'suspensionExpiry'
        ])
      ));

      // Users can only delete their own account
      allow delete: if isOwner(userId);

      // ─── Saved Searches Subcollection (per-user, owner-only) ───
      match /savedSearches/{searchId} {
        allow read, write: if isOwner(userId);

        // Create additionally enforces shape. The 50-search cap is enforced
        // client-side (rules cannot count a collection).
        allow create: if isOwner(userId) &&
          request.resource.data.keys().hasAll([
            'name', 'filters', 'notificationFrequency', 'isActive',
            'matchCount', 'newMatchCount', 'createdAt', 'updatedAt'
          ]) &&
          request.resource.data.name is string &&
          request.resource.data.name.size() >= 1 &&
          request.resource.data.name.size() <= 60 &&
          request.resource.data.notificationFrequency in ['instant', 'daily', 'weekly'] &&
          request.resource.data.isActive is bool &&
          request.resource.data.filters is map;

        allow update: if isOwner(userId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'filters', 'notificationFrequency', 'isActive',
            'matchCount', 'newMatchCount', 'lastRunAt', 'lastNotifiedAt',
            'updatedAt'
          ]);
      }
    }

    // ═══════════════════════════════════════════════════════════
    // PROPERTIES COLLECTION
    // ═══════════════════════════════════════════════════════════
    match /properties/{propertyId} {
      // Anyone can read active properties; authenticated users can read all
      allow read: if isAuthenticated();

      // Authenticated, non-suspended users can create properties for themselves
      allow create: if isAuthenticated() && !isSuspended() &&
        propertyDataIsValid() &&
        request.resource.data.userId == request.auth.uid &&
        withinWriteLimit();

      // Owner can edit listing fields; ANY authenticated user may bump views.
      // (Rate limiting applies to owner edits but not passive view bumps.)
      allow update: if isAuthenticated() && (
        (isPropertyOwner(propertyId) &&
          propertyEditFieldsAreValid() &&
          versionBumpedExactlyOnce() &&
          withinWriteLimit())
        ||
        // Passive view counting on detail views.
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
        ||
        // Moderation: admins may hide listings without going through the
        // owner's optimistic-lock/rate-limit path.
        (isAdmin() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'archived', 'archivedAt', 'archiveReason', 'updatedAt'
          ]))
      );

      // Only the property owner can delete; admins may remove listings for
      // moderation (reports) — the removal is audited via admin/auditLog.
      allow delete: if (isPropertyOwner(propertyId) && withinWriteLimit()) || isAdmin();

      // ─── Messages Subcollection (under properties for direct messaging) ───
      match /messages/{messageId} {
        allow read, write: if false; // Messages are in conversations subcollection
      }
    }

    // ═══════════════════════════════════════════════════════════
    // CONVERSATIONS COLLECTION
    // ═══════════════════════════════════════════════════════════
    match /conversations/{conversationId} {
      // Only participants can read conversations
      allow read: if isAuthenticated() &&
        isParticipant(resource.data.participants);

      // Any authenticated user can create a conversation
      // (they must be one of the participants)
      allow create: if isAuthenticated() && !isSuspended() &&
        isParticipant(request.resource.data.participants) &&
        request.resource.data.participants.size() == 2 &&
        request.resource.data.keys().hasAll([
          'participants', 'participantNames', 'participantPhotos',
          'lastMessage', 'lastMessageTime', 'lastMessageSenderId',
          'unreadCount', 'propertyId', 'propertyTitle', 'propertyImage',
          'createdAt', 'updatedAt'
        ]);

      // Participants can update conversation metadata (last message, unread counts)
      allow update: if isAuthenticated() &&
        isParticipant(resource.data.participants);

      // No one should delete conversations directly
      allow delete: if false;

      // ─── Messages Subcollection ───
      match /messages/{messageId} {
        // Only participants can read messages
        allow read: if isAuthenticated() &&
          isParticipant(get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants);

        // Participants can create messages (must be the sender)
        allow create: if isAuthenticated() && !isSuspended() &&
          isParticipant(get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants) &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.keys().hasAll([
            'conversationId', 'senderId', 'text', 'read', 'createdAt'
          ]);

        // Participants can update messages (for read receipts)
        allow update: if isAuthenticated() &&
          isParticipant(get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants) &&
          // Only allow updating 'read' field and optionally 'image'
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'read', 'image'
          ]);

        // Data-erasure: users can delete their own messages (account
        // deletion wipes chat history per-sender).
        allow delete: if isAuthenticated() &&
          resource.data.senderId == request.auth.uid;
      }
    }

    // ═══════════════════════════════════════════════════════════
    // NOTIFICATIONS COLLECTION
    // ═══════════════════════════════════════════════════════════
    match /notifications/{notificationId} {
      // Users can only read their own notifications
      allow read: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;

      // Any authenticated user can create notifications for others
      // (system sends notifications, or users notify each other)
      allow create: if isAuthenticated() && !isSuspended() &&
        request.resource.data.keys().hasAll([
          'userId', 'title', 'body', 'type', 'data', 'read', 'createdAt'
        ]) &&
        request.resource.data.type in [
          'message', 'inquiry', 'price_drop', 'new_listing', 'favorite', 'system'
        ];

      // Users can only update their own notifications (mark as read)
      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);

      // Users can delete their own notifications
      allow delete: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
    }

    // ═══════════════════════════════════════════════════════════
    // CONFIG COLLECTION (public, read-only app configuration)
    // ═══════════════════════════════════════════════════════════
    // Public docs the app renders — currently `config/app_notice` (the
    // in-app notice banner, see src/components/common/NoticeBanner.tsx).
    // Writes happen only through the Firebase console / Admin SDK, never
    // from clients, so rules deny all client writes.
    match /config/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ═══════════════════════════════════════════════════════════
    // ADMIN COLLECTION (role-gated moderation)
    // ═══════════════════════════════════════════════════════════
    // Role docs are provisioned by operators (console/Admin SDK) and gate
    // everything else under /admin. Firestore triggers in functions/ watch
    // security_alerts / breach_broadcasts (server writes bypass rules).
    match /admin/roles/{uid} {
      // A user may check their own role (used to gate the admin UI).
      allow read: if isAuthenticated() && request.auth.uid == uid;
      allow write: if false;
    }

    // Announcements are authored by admins and read by all signed-in users
    // (NoticeBanner renders the latest active one).
    match /admin/announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // Reports are created by any signed-in user; only admins triage them.
    match /admin/reports/{reportId} {
      allow create: if isAuthenticated() && !isSuspended() &&
        request.resource.data.keys().hasAll([
          'propertyId', 'reporterId', 'reason', 'status', 'createdAt'
        ]) &&
        request.resource.data.reporterId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.reason in ['inappropriate', 'scam', 'duplicate', 'other'];
      allow read, update, delete: if isAdmin();
    }

    // Audit trail: admins append; operators may query via Admin SDK.
    match /admin/auditLog/{entryId} {
      allow create, read: if isAdmin();
      allow update, delete: if false;
    }

    // Everything else under /admin (metrics, settings, security_alerts,
    // breach_broadcasts) is admin-only for clients.
    match /admin/{document=**} {
      allow read, write: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════
    // REVIEWS COLLECTION
    // ═══════════════════════════════════════════════════════════
    match /reviews/{reviewId} {
      // Anyone authenticated can read non-removed reviews
      allow read: if isAuthenticated();

      // Verified purchasers can create reviews (one per property per buyer)
      allow create: if isAuthenticated() && !isSuspended() &&
        request.resource.data.buyerId == request.auth.uid &&
        request.resource.data.keys().hasAll([
          'propertyId', 'sellerId', 'buyerId', 'rating', 'title', 'content',
          'pros', 'cons', 'isVerifiedPurchase', 'isFlagged', 'isRemoved',
          'createdAt', 'updatedAt'
        ]) &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5 &&
        request.resource.data.isFlagged == false &&
        request.resource.data.isRemoved == false;

      // Only the buyer can update their own review (for response, flagging)
      allow update: if isAuthenticated() &&
        resource.data.buyerId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'sellerResponse', 'isFlagged', 'updatedAt'
        ]);

      // Admins can remove flagged reviews
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'isRemoved', 'isFlagged', 'updatedAt'
        ]);

      // No direct deletion; reviews are soft-deleted via isRemoved flag
      allow delete: if false;
    }

    // ═══════════════════════════════════════════════════════════
    // TOURS COLLECTION
    // ═══════════════════════════════════════════════════════════
    match /tours/{tourId} {
      // Only buyer and seller involved can read tours
      allow read: if isAuthenticated() &&
        (request.auth.uid == resource.data.buyerId ||
         request.auth.uid == resource.data.sellerId);

      // Buyers can create tour requests
      allow create: if isAuthenticated() && !isSuspended() &&
        request.resource.data.buyerId == request.auth.uid &&
        request.resource.data.keys().hasAll([
          'propertyId', 'propertyTitle', 'propertyImage', 'buyerId',
          'buyerName', 'sellerId', 'sellerName', 'status', 'datetime',
          'duration', 'attendees', 'notes', 'reminderSent',
          'createdAt', 'updatedAt'
        ]) &&
        request.resource.data.status == 'pending';

      // Buyer and seller can update status (confirm/decline/cancel)
      allow update: if isAuthenticated() &&
        (request.auth.uid == resource.data.buyerId ||
         request.auth.uid == resource.data.sellerId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'confirmedAt', 'canceledBy', 'cancelReason',
          'reminderSent', 'updatedAt', 'datetime'
        ]);

      allow delete: if false;
    }

    // ═══════════════════════════════════════════════════════════
    // TOUR AVAILABILITY COLLECTION
    // ═══════════════════════════════════════════════════════════
    match /tourAvailability/{sellerId} {
      // Anyone authenticated can read availability
      allow read: if isAuthenticated();

      // Only the seller can set their availability
      allow create, update: if isOwner(sellerId);

      allow delete: if false;
    }

    // ═══════════════════════════════════════════════════════════
    // NEIGHBORHOOD DATA COLLECTION (server-managed cache)
    // ═══════════════════════════════════════════════════════════
    match /neighborhood_data/{docId} {
      // Anyone authenticated can read neighborhood data
      allow read: if isAuthenticated();

      // Only admins and Cloud Functions can write neighborhood data
      allow write: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════
    // EXPORTS COLLECTION (GDPR data export)
    // ═══════════════════════════════════════════════════════════
    match /exports/{exportId} {
      // Users can only read their own exports
      allow read: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;

      // Users can create their own export requests
      allow create: if isAuthenticated() && !isSuspended() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.keys().hasAll([
          'userId', 'status', 'createdAt', 'expiresAt'
        ]) &&
        request.resource.data.status == 'pending';

      // Only the requesting user or admins can update
      allow update: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());

      allow delete: if false;
    }

    // ═══════════════════════════════════════════════════════════
    // ANALYTICS COLLECTION (admin dashboard metrics)
    // ═══════════════════════════════════════════════════════════
    match /analytics/{date} {
      // Admins can read/write analytics
      allow read, write: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════
    // DEFAULT: DENY ALL OTHER PATHS
    // ═══════════════════════════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
