rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ──────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/admin_roles/$(request.auth.uid));
    }

    // Suspended accounts may keep reading their own data (GDPR) but cannot
    // create listings, conversations, messages, or notifications.
    function isSuspended() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.suspended == true;
    }

    function isParticipant(userIds) {
      return isAuthenticated() && request.auth.uid in userIds;
    }

    function isPropertyOwner(propertyId) {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/properties/$(propertyId)).data.userId == request.auth.uid;
    }

    function userDataIsValid() {
      return      request.resource.data.keys().hasAll([
        'uid', 'email', 'displayName', 'phoneNumber', 'photoURL',
        'bio', 'role', 'favorites', 'createdAt', 'updatedAt'
      ]) &&
      request.resource.data.email is string &&
      request.resource.data.displayName is string &&
      request.resource.data.role in ['buyer', 'seller', 'agent'];
    }

    function propertyDataIsValid() {
      return request.resource.data.keys().hasAll([
        'title', 'description', 'price', 'listingType', 'propertyType',
        'status', 'address', 'city', 'state', 'zipCode', 'country',
        'latitude', 'longitude', 'bedrooms', 'bathrooms', 'area',
        'areaUnit', 'yearBuilt', 'images', 'features', 'amenities',
        'userId', 'userName', 'userPhoto', 'userPhone',
        'views', 'inquiries', 'createdAt', 'updatedAt',
        'archived', 'contactEnabled', 'verified'
      ]) &&
      request.resource.data.listingType in ['sale', 'rent'] &&
      request.resource.data.propertyType in [
        'house', 'apartment', 'condo', 'townhouse', 'land', 'commercial'
      ] &&
      // New listings always start Active and unarchived; owners move them
      // through the deal lifecycle via updates (propertyEditFieldsAreValid).
      request.resource.data.status == 'active' &&
      request.resource.data.archived == false &&
      // SECURITY: listings can only be created UNVERIFIED — `verified` is an
      // admin-only flag (moderation branch of allow update below) and is
      // pinned here so a crafted create payload can't self-grant the badge.
      request.resource.data.verified == false &&
      request.resource.data.contactEnabled is bool &&
      request.resource.data.images is list;
    }

    function propertyEditFieldsAreValid() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'title', 'description', 'price', 'listingType', 'propertyType',
        'status', 'address', 'city', 'state', 'zipCode', 'country',
        'latitude', 'longitude', 'bedrooms', 'bathrooms', 'area', 'areaUnit',
        'yearBuilt', 'images', 'features', 'amenities',
        'views', 'inquiries', 'version', 'soldDate', 'pendingDate',
        'contactEnabled', 'archived', 'archivedAt', 'archiveReason',
        // Video walkthrough (owner-managed, one per listing, Size/URL
        // validated client-side before upload — see VIDEO_CONFIG).
        'videoUrl', 'videoDurationSeconds',
        // SECURITY: `verified`, avgResponseMinutes and conversationCount are
        // deliberately absent — `verified` is admin-only (moderation branch of
        // allow update) and the response-time stats are written only by the
        // sellerResponseTracking Cloud Function (Admin SDK, bypasses rules).
        'expirationDate', 'updatedAt'
      ]);
    }

    // Optimistic locking: the client must bump `version` by exactly 1 from the
    // version it read. Docs created before versioning (no `version` field) are
    // treated as version 0, so their first edit writes version 1.
    function versionBumpedExactlyOnce() {
      return !('version' in resource.data)
        ? request.resource.data.version == 1
        : request.resource.data.version == resource.data.version + 1;
    }

    // ─── Rate limiting ─────────────────────────────────────────
    // Per-user write budget: max 100 writes per wall-clock minute.
    // SCOPE: applied ONLY to property create/update/delete, where the client
    // includes the counters/{uid} bump in the same batch (see
    // src/services/propertyService.ts, withWriteCount). View bumps and
    // message sends intentionally do NOT use this budget: their batches
    // never carry a counter write, so requiring one denies them outright.
    // Firestore rules alone cannot make this budget tamper-proof
    // (counters/{uid} must remain client-writable for the merge-bump
    // pattern): authoritative enforcement is server-side — App Check,
    // Cloud Functions budgets, and analyzeSecurityLogs anomaly alerts.
    function writeBudgetRef() {
      return /databases/$(database)/documents/counters/$(request.auth.uid);
    }

    // Enforces (rules functions are expression-only — `let` bindings followed
    // by a single `return`, no if/else statements):
    //  - the batch writes counters/{uid} (so the after-state below exists),
    //  - the running count stays in [1, WRITE_LIMIT],
    //  - the first counter ever starts at 1,
    //  - same-minute writes increment the count by exactly 1, and
    //  - a new minute bucket starts fresh (any rollover count <= limit is OK).
    // The client writes an integer minute bucket (Math.floor(epochMs/60000));
    // comparing client-written minutes (before vs after) is exact, unlike
    // deriving the bucket from request.time (microsecond precision).
    function withinWriteLimit() {
      let after = getAfter(writeBudgetRef());
      let before = get(writeBudgetRef());
      return after.data.writes >= 1
          && after.data.writes <= 100
          && (!exists(writeBudgetRef())
            // First counter ever — must start at 1.
            ? after.data.writes == 1
            // Rolled into a new minute — client rewrote the bucket, so any
            // count up to the limit is fine.
            : before.data.minute != after.data.minute
              // Same minute — must be a clean +1 (increments serialize).
              || after.data.writes == before.data.writes + 1);
    }

    // Per-user DAILY read budget (see src/utils/firestore/readBudget.ts).
    // The default cap is 10000/day; admins can raise it per user via the
    // `readBudgetOverride` field on the user doc (adminService), which the
    // rule reads so an overridden user's counter can legitimately exceed
    // the default. One extra users/{uid} read per counter flush (10s max
    // cadence) is an acceptable cost for rule-level admin control.
    function readBudgetCap() {
      let override = get(/databases/$(database)/documents/users/$(request.auth.uid))
        .get('readBudgetOverride', 0);
      return override > 0 ? override : 10000;
    }

    // counters/{uid} writes carry EITHER the write-budget pair (minute,
    // writes) OR the read-budget triple (readsToday, readsResetAt,
    // flushWindowReset) — or a subset, since merge-writes produce the
    // union of existing and new fields in request.resource.data. The hard
    // guarantee: readsToday can never be written past the effective cap.
    function countersWriteIsValid() {
      let d = request.resource.data;
      let keysOk = d.keys().hasOnly([
        'minute', 'writes', 'readsToday', 'readsResetAt', 'flushWindowReset'
      ]);
      let typesOk = (!('minute' in d) || d.minute is number)
          && (!('writes' in d) || d.writes is number)
          && (!('readsToday' in d) || d.readsToday is number)
          && (!('readsResetAt' in d) || d.readsResetAt is number)
          && (!('flushWindowReset' in d) || d.flushWindowReset is number);
      let readsOk = !('readsToday' in d)
          || (d.readsToday >= 0 && d.readsToday <= readBudgetCap());
      // A reset instant, when written, must still be in the future — a
      // client can't zero-out its own counter by backdating the window.
      let resetOk = !('readsResetAt' in d)
          || d.readsResetAt > request.time.toMillis();
      return keysOk && typesOk && readsOk && resetOk;
    }

    // ═══════════════════════════════════════════════════════════
    // COUNTERS COLLECTION (rate limiting bookkeeping)
    // ═══════════════════════════════════════════════════════════
    match /counters/{userId} {
      // Rate-limit bookkeeping: the write-budget pair { minute, writes }
      // (withinWriteLimit()) and the daily read-budget triple
      // { readsToday, readsResetAt, flushWindowReset }
      // (src/utils/firestore/readBudget.ts). Shape-locked so the doc can't
      // be repurposed as arbitrary storage; the read cap is enforced HERE
      // so a compromised client can't write itself past the budget.
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId) && countersWriteIsValid();
      allow delete: if false;
    }

    // ═══════════════════════════════════════════════════════════
    // HEALTH CHECK COLLECTION (empty; used to probe connectivity)
    // ═══════════════════════════════════════════════════════════
    match /healthcheck/{doc} {
      allow read: if isAuthenticated();
    }

    // ═══════════════════════════════════════════════════════════
    // USERS COLLECTION
    // ═══════════════════════════════════════════════════════════
    match /users/{userId} {
      // SECURITY (HIGH 5): Restrict user profile reads.
      // Sensitive fields (email, phoneNumber) should only be visible to:
      //   - The user themselves
      //   - Admins
      //   - Property owners (for buyer inquiries on their listings)
      // Other users see the public profile fields only.
      // NOTE: Firebase rules cannot do field-level reads, so this is enforced
      // at the service layer (authService strips sensitive fields before
      // returning to the UI). This rule provides the access gate.
      allow read: if isAuthenticated();

      // Users can only create their own profile with correct doc ID
      allow create: if isOwner(userId) && userDataIsValid();

      // Users can only update their own profile (admins may suspend via the
      // dedicated suspend fields — see users/update allowlist).
      allow update: if isOwner(userId) && (        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'phoneNumber', 'photoURL', 'bio', 'role', 'favorites',
          'termsAcceptedAt', 'termsAcceptedVersion', 'expoPushToken', 'updatedAt',
          'notificationsPaused', 'notificationPrefs',
          'averageRating', 'totalReviews'
        ])
      ) || (isAdmin() && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'suspended', 'suspensionReason', 'suspensionExpiry',
          'readBudgetOverride'
        ])
      ));

      // Users can only delete their own account
      allow delete: if isOwner(userId);

      // ─── Saved Searches Subcollection (per-user, owner-only) ───
      match /savedSearches/{searchId} {
        allow read, write: if isOwner(userId);

        // Create additionally enforces shape. The 50-search cap is enforced
        // client-side (rules cannot count a collection).
        allow create: if isOwner(userId) &&
          request.resource.data.keys().hasAll([
            'name', 'filters', 'notificationFrequency', 'isActive',
            'matchCount', 'newMatchCount', 'createdAt', 'updatedAt'
          ]) &&
          request.resource.data.name is string &&
          request.resource.data.name.size() >= 1 &&
          request.resource.data.name.size() <= 60 &&
          request.resource.data.notificationFrequency in ['instant', 'daily', 'weekly', 'off'] &&
          request.resource.data.isActive is bool &&
          request.resource.data.filters is map;

        allow update: if isOwner(userId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'filters', 'notificationFrequency', 'isActive',
            'matchCount', 'newMatchCount', 'lastRunAt', 'lastNotifiedAt',
            'updatedAt'
          ]);
      }

      // ─── Per-user stats (precomputed nightly + incremental on writes) ───
      match /stats/{role} {
        // Client READ: authenticated users may read their own (and any)
        // stats doc — the dashboard screens do exactly one read each.
        allow read: if isAuthenticated();

        // Client WRITE: denied. Only Cloud Functions (nightly summary job
        // `updateUserStats`, and the incremental `onPropertyUpdate`/
        // `onDealUpdate` triggers) may write `users/{uid}/stats/*`.
        allow write: if false;
      }

      // ─── Chat activity meta (Cloud-Function-only) ───
      // `users/{uid}/meta/chat` = { lastMessageAt, unreadCount } — the
      // conversations list's single-doc change signal (1 read per change
      // instead of a per-conversation listener). Written ONLY by the
      // platformChat triggers (Admin SDK bypasses rules); the owner reads
      // it via chatService.subscribeToChatMeta, no client may write it.
      match /meta/{metaId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
    }

    // ═══════════════════════════════════════════════════════════
    // PROPERTIES COLLECTION
    // ═══════════════════════════════════════════════════════════
    match /properties/{propertyId} {
      // Anyone can read active properties; authenticated users can read all
      allow read: if isAuthenticated();

      // Authenticated, non-suspended users can create properties for themselves
      allow create: if isAuthenticated() && !isSuspended() &&
        propertyDataIsValid() &&
        request.resource.data.userId == request.auth.uid &&
        withinWriteLimit();

      // SECURITY (MEDIUM 9): View bumps are limited to +1 per write.
      // The view field must be exactly resource.data.views + 1, preventing
      // mass-inflation attacks.
      function viewBumpIsValid() {
        return request.resource.data.views == resource.data.views + 1;
      }

      // Owner can edit listing fields; view bumps are rate-limited to +1.
      // (Rate limiting applies to owner edits AND view bumps.)
      allow update: if isAuthenticated() && (
        (isPropertyOwner(propertyId) &&
          propertyEditFieldsAreValid() &&
          versionBumpedExactlyOnce() &&
          withinWriteLimit())
        ||
        // Passive view counting: only a clean +1 increment. Rate limiting is
        // enforced server-side (App Check + securityMonitor) — view batches
        // never carry the counters write that withinWriteLimit() requires.
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
          && viewBumpIsValid())
        ||
        // Moderation: admins may hide listings and toggle `verified` without
        // going through the owner's optimistic-lock/rate-limit path.
        (isAdmin() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'archived', 'archivedAt', 'archiveReason', 'updatedAt', 'verified'
          ]))
      );

      // Only the property owner can delete; admins may remove listings for
      // moderation (reports) — the removal is audited via admin_auditLog.
      allow delete: if (isPropertyOwner(propertyId) && withinWriteLimit()) || isAdmin();

      // ─── Price History Subcollection ───
      // Written by the property owner when price changes (in the same batch as
      // the property edit — write limit is enforced on the property update).
      // Read by any authenticated user for the detail-screen chart.
      match /priceHistory/{entryId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && isPropertyOwner(propertyId);
        allow update, delete: if false;
      }

      // ─── View Events Subcollection (server-side view counting) ───
      // Each counted view is a create-only document
      // `properties/{propertyId}/viewEvents/{uid}_{yyyy-mm-dd}` (UTC day;
      // written by `recordViewEvent` in src/services/propertyService.ts).
      // The doc-id IS the rate-limit guard: `{uid}` pins the event to its
      // author and `{yyyy-mm-dd}` collapses a whole day into a single id, so
      // create-only semantics cap a user at ONE event per property per UTC
      // day. The `countViewEvent` trigger (functions/src/viewEvents.ts)
      // re-validates the id against the event's own timestamp (rules cannot
      // format `request.time` as a date string), then bumps the parent's
      // `views` by exactly +1 — clients never write `views` for counting.
      match /viewEvents/{eventId} {
        // Reads are need-to-know: the listing owner (audience data), the
        // viewer themself, or an admin — viewer identity is personal data,
        // so this is never a general authenticated read.
        allow read: if isPropertyOwner(propertyId)
          || isAdmin()
          || (isAuthenticated() && resource.data.userId == request.auth.uid);

        // Shape-locked create: the id must be exactly `{auth.uid}_{yyyy-mm-dd}`
        // — `split()` pins the prefix to the caller WITHOUT interpolating the
        // uid into a regex (uids containing `_` fail closed and simply don't
        // count) — and the payload holds only the attribution field the
        // trigger cross-checks. No update/delete: the unique id plus
        // create-only access is what makes the rate limit unbreakable.
        function viewEventIsValid() {
          let parts = eventId.split('_');
          return parts.size() == 2
            && parts[0] == request.auth.uid
            && parts[1].matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && request.resource.data.keys().hasOnly(['userId'])
            && request.resource.data.userId == request.auth.uid;
        }
        allow create: if isAuthenticated() && viewEventIsValid();
        allow update, delete: if false;
      }

      // ─── Messages Subcollection (under properties for direct messaging) ───
      match /messages/{messageId} {
        allow read, write: if false; // Messages are in conversations subcollection
      }
    }

    // ═══════════════════════════════════════════════════════════
    // CONVERSATIONS COLLECTION
    // ═══════════════════════════════════════════════════════════
    match /conversations/{conversationId} {
      // Only participants can read conversations
      allow read: if isAuthenticated() &&
        isParticipant(resource.data.participants);

      // Any authenticated user can create a conversation
      // (they must be one of the participants)
      allow create: if isAuthenticated() && !isSuspended() &&
        isParticipant(request.resource.data.participants) &&
        request.resource.data.participants.size() == 2 &&
        request.resource.data.keys().hasAll([
          'participants', 'participantNames', 'participantPhotos',
          'lastMessage', 'lastMessageTime', 'lastMessageSenderId',
          'unreadCount', 'propertyId', 'propertyTitle', 'propertyImage',
          'createdAt', 'updatedAt'
        ]);

      // Participants can update conversation metadata (last message, unread counts,
      // firstSellerReplyAt for response-time tracking).
      allow update: if isAuthenticated() &&
        isParticipant(resource.data.participants) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastMessage', 'lastMessageTime', 'lastMessageSenderId',
          'unreadCount', 'updatedAt', 'firstSellerReplyAt'
        ]);

      // No one should delete conversations directly
      allow delete: if false;

      // ─── Read receipts (batched — replaces per-message `read` writes) ───
      // Each participant records ONLY their own receipt:
      // `conversations/{id}/reads/{uid}` = { lastReadAt } (server time),
      // throttled client-side to ≤1 write / 5s (chatService
      // .recordReadReceipt). The platformChatOnRead trigger resets this
      // conversation's unread badge for that reader. Shape-locked so the
      // doc can't be repurposed, and pinned to auth.uid so nobody can forge
      // another reader's "I've read this" state.
      match /reads/{readerId} {
        allow read: if isAuthenticated() &&
          isParticipant(get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants);
        allow create, update: if isAuthenticated() &&
          request.auth.uid == readerId &&
          isParticipant(get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants) &&
          request.resource.data.keys().hasOnly(['lastReadAt']) &&
          request.resource.data.lastReadAt == request.time;
        allow delete: if false;
      }

      // ─── Messages Subcollection ───
      match /messages/{messageId} {
        // Only participants can read messages
        allow read: if isAuthenticated() &&
          isParticipant(get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants);

        // SECURITY (LOW 15): Participants can create messages (must be the
        // sender). Message-send batches intentionally omit the counters
        // write (requiring it would deny every send — the property-path
        // budget never applied to messaging), so abuse here is mitigated
        // server-side (App Check + securityMonitor), not via withinWriteLimit().
        allow create: if isAuthenticated() && !isSuspended() &&
          isParticipant(get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants) &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.keys().hasAll([
            'conversationId', 'senderId', 'text', 'read', 'createdAt'
          ]);

        // Participants can update messages (for read receipts)
        allow update: if isAuthenticated() &&
          isParticipant(get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants) &&
          // Only allow updating 'read' field and optionally 'image'
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'read', 'image'
          ]);

        // Data-erasure: users can delete their own messages (account
        // deletion wipes chat history per-sender).
        allow delete: if isAuthenticated() &&
          resource.data.senderId == request.auth.uid;
      }
    }

    // ═══════════════════════════════════════════════════════════
    // NOTIFICATIONS COLLECTION
    // ═══════════════════════════════════════════════════════════
    match /notifications/{notificationId} {
      // Users can only read their own notifications
      allow read: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;

      // SECURITY (HIGH 3): Restrict notification creation.
      // Only the recipient (userId == auth.uid) or server-side Cloud Functions
      // (which bypass rules via Admin SDK) can create notifications.
      // This prevents phishing spam where an attacker creates fake
      // notifications for other users.
      allow create: if isAuthenticated() && !isSuspended() &&
        // User can only create notifications addressed to themselves
        // (e.g., marking their own notification preferences).
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.keys().hasAll([
          'userId', 'title', 'body', 'type', 'data', 'read', 'createdAt'
        ]) &&
        request.resource.data.type in [
          'message', 'inquiry', 'price_drop', 'new_listing', 'favorite',
          'tour_approved', 'system'
        ];

      // Users can only update their own notifications (mark as read)
      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);

      // Users can delete their own notifications
      allow delete: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
    }

    // ─── Metrics (Firestore cost accounting) ───────────────────────
    // One aggregated doc per local day (metrics/{yyyy-mm-dd}) that clients
    // merge per-collection read/write counters into with increment() ops
    // (src/utils/monitoring/firestoreMetrics.ts). Clients are WRITE-ONLY
    // (a compromised client can poison counters but never read others');
    // reads are admin-only via admin_roles. Shape-checked loosely: top-level
    // keys are allowlisted and per-op map growth is capped (increment
    // transforms can't be range-checked in rules).
    match /metrics/{date} {
      allow create, update: if isAuthenticated() && !isSuspended() &&
        request.resource.data.keys().hasOnly(['reads', 'writes', 'updatedAt']) &&
        (!('reads' in request.resource.data) || request.resource.data.reads.keys().size() <= 100) &&
        (!('writes' in request.resource.data) || request.resource.data.writes.keys().size() <= 100);
      allow read: if isAdmin();
      allow delete: if false;
    }

    // ═══════════════════════════════════════════════════════════
    // CONFIG COLLECTION (public, read-only app configuration)
    // ═══════════════════════════════════════════════════════════
    // Public docs the app renders — currently `config/app_notice` (the
    // in-app notice banner, see src/components/common/NoticeBanner.tsx).
    // Writes happen only through the Firebase console / Admin SDK, never
    // from clients, so rules deny all client writes.
    match /config/{docId} {
      // `metrics` (platform totals maintained by the platformMetrics Cloud
      // Function triggers) is admin-only: aggregate user/listing/report
      // counts are not public data. Everything else stays public.
      allow read: if docId != 'metrics' || isAdmin();
      allow write: if false; // Cloud Functions (Admin SDK) / console only
    }

    // ═══════════════════════════════════════════════════════════
    // ADMIN COLLECTION (role-gated moderation)
    // ═══════════════════════════════════════════════════════════
    // Role docs are provisioned by operators (console/Admin SDK) and gate
    // everything else in the admin_* collections. Firestore triggers in
    // functions/ watch admin_security_alerts / admin_breach_broadcasts
    // (server writes bypass rules).
    match /admin_roles/{uid} {
      // A user may check their own role (used to gate the admin UI).
      allow read: if isAuthenticated() && request.auth.uid == uid;
      allow write: if false;
    }

    // Announcements are authored by admins and read by all signed-in users
    // (NoticeBanner renders the latest active one).
    match /admin_announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // Reports are created by any signed-in user; only admins triage them.
    // Two shapes: listing reports (propertyId set) and user reports
    // (type == 'user', reportedUserId set, propertyId pinned to '').
    match /admin_reports/{reportId} {
      allow create: if isAuthenticated() && !isSuspended() &&
        request.resource.data.keys().hasAll([
          'reporterId', 'reason', 'status', 'createdAt'
        ]) &&
        request.resource.data.reporterId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.reason in ['inappropriate', 'scam', 'duplicate', 'other'] &&
        (
          (
            (request.resource.data.type == 'listing' || !('type' in request.resource.data)) &&
            request.resource.data.keys().hasAll(['propertyId']) &&
            request.resource.data.propertyId is string &&
            request.resource.data.propertyId.size() > 0
          )
          ||
          (
            request.resource.data.type == 'user' &&
            request.resource.data.keys().hasAll(['reportedUserId']) &&
            request.resource.data.reportedUserId is string &&
            request.resource.data.reportedUserId.size() > 0 &&
            request.resource.data.propertyId == '' &&
            request.resource.data.reportedUserId != request.auth.uid
          )
        );
      allow read, update, delete: if isAdmin();
    }

    // Audit trail: admins append; operators may query via Admin SDK.
    match /admin_auditLog/{entryId} {
      allow create, read: if isAdmin();
      allow update, delete: if false;
    }

    // Server-side security namespaces (written via the Admin SDK / console —
    // see functions/src/securityMonitor.ts). Admin-only for clients.
    match /admin_securityLogs/{document=**} {
      allow read, write: if isAdmin();
    }
    match /admin_securityReports/{document=**} {
      allow read, write: if isAdmin();
    }
    match /admin_security_alerts/{document=**} {
      allow read, write: if isAdmin();
    }
    match /admin_breach_broadcasts/{document=**} {
      allow read, write: if isAdmin();
    }
    // Audit rate-limit counters are internal — never client-accessible.
    match /admin_auditRateLimits/{document=**} {
      allow read, write: if false;
    }

    // ═══════════════════════════════════════════════════════════
    // REVIEWS COLLECTION
    // ═══════════════════════════════════════════════════════════
    match /reviews/{reviewId} {
      // Anyone authenticated can read non-removed reviews
      allow read: if isAuthenticated();

      // Verified purchasers can create reviews (one per property per buyer)
      allow create: if isAuthenticated() && !isSuspended() &&
        request.resource.data.buyerId == request.auth.uid &&
        request.resource.data.keys().hasAll([
          'propertyId', 'sellerId', 'buyerId', 'rating', 'title', 'content',
          'pros', 'cons', 'isVerifiedPurchase', 'isFlagged', 'isRemoved',
          'createdAt', 'updatedAt'
        ]) &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5 &&
        request.resource.data.isFlagged == false &&
        request.resource.data.isRemoved == false;

      // SECURITY (MEDIUM 8): Consolidated update rule.
      // Buyers can flag their own reviews.
      // Any authenticated user can flag any review for moderation.
      // Sellers can respond to reviews about their listings.
      // Admins can remove, flag, or modify any review.
      // Fields are strictly scoped per role to prevent privilege escalation.
      allow update: if isAuthenticated() && (
        // Buyer updating their own review — limited to flagging
        (resource.data.buyerId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'isFlagged', 'updatedAt'
          ]))
        ||
        // Any user can flag any review for moderation (anti-abuse)
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'isFlagged', 'updatedAt'
        ]))
        ||
        // Seller responding to a review about their listing
        (resource.data.sellerId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'sellerResponse', 'updatedAt'
          ]))
        ||
        // Admin moderation — can remove, flag, or add seller response
        (isAdmin() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'isRemoved', 'isFlagged', 'sellerResponse', 'updatedAt'
          ]))
      );

      // No direct deletion; reviews are soft-deleted via isRemoved flag
      allow delete: if false;
    }

    // ═════════════════════════════════════════════════════════
    // DEALS COLLECTION (agent commission tracking)
    // ═════════════════════════════════════════════════════════
    // Agent-owned deal records against their own listings. Strictly
    // owner-scoped; no client deletes (mark status: lost instead).
    match /deals/{dealId} {
      // Only the owning agent can read their deals.
      allow read: if isAuthenticated() && resource.data.agentId == request.auth.uid;

      allow create: if isAuthenticated() && !isSuspended() &&
        request.resource.data.agentId == request.auth.uid &&
        request.resource.data.propertyId is string &&
        request.resource.data.propertyId.size() >= 1 &&
        request.resource.data.salePrice is number &&
        request.resource.data.salePrice >= 0 &&
        request.resource.data.salePrice <= 1000000000 &&
        request.resource.data.commissionRate is number &&
        request.resource.data.commissionRate >= 0 &&
        request.resource.data.commissionRate <= 100 &&
        request.resource.data.closedAt is string &&
        request.resource.data.status in ['pipeline', 'closed', 'lost'] &&
        request.resource.data.keys().hasOnly([
          'agentId', 'propertyId', 'buyerId', 'buyerName', 'salePrice',
          'commissionRate', 'closedAt', 'status', 'notes',
          'createdAt', 'updatedAt'
        ]);

      // Owner can update metrics/status; agentId and propertyId are immutable
      // and the numeric bounds are re-checked on every write.
      allow update: if isAuthenticated() &&
        resource.data.agentId == request.auth.uid &&
        request.resource.data.agentId == resource.data.agentId &&
        request.resource.data.propertyId == resource.data.propertyId &&
        request.resource.data.salePrice is number &&
        request.resource.data.salePrice >= 0 &&
        request.resource.data.salePrice <= 1000000000 &&
        request.resource.data.commissionRate is number &&
        request.resource.data.commissionRate >= 0 &&
        request.resource.data.commissionRate <= 100 &&
        request.resource.data.status in ['pipeline', 'closed', 'lost'];

      allow delete: if false;
    }

    // ═════════════════════════════════════════════════════════
    // USER REVIEWS COLLECTION (peer reputation)
    // ═════════════════════════════════════════════════════════
    // One user rating another after a real interaction (completed viewing or
    // 5+ message chat). Strictly reviewer-authored; admins may remove abuse.
    match /userReviews/{reviewId} {
      // Anyone authenticated can read a user's reputation.
      allow read: if isAuthenticated();

      // Only the reviewer can create; reviewer ≠ reviewee; rating 1–5;
      // text bounded; timestamps must be server-set.
      allow create: if isAuthenticated() && !isSuspended() &&
        request.resource.data.reviewerId == request.auth.uid &&
        request.resource.data.revieweeId is string &&
        request.resource.data.revieweeId != request.auth.uid &&
        request.resource.data.rating is number &&
        request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
        request.resource.data.text is string &&
        request.resource.data.text.size() <= 1000 &&
        request.resource.data.keys().hasOnly([
          'reviewerId', 'revieweeId', 'rating', 'text', 'createdAt',
          'reviewerName', 'revieweeName', 'propertyId', 'tourId', 'conversationId'
        ]) &&
        request.resource.data.createdAt == request.time;

      // No client updates (no edits, no vote brigading).
      allow update: if false;

      // Abusive reviews are removed by admins only. Authors cannot delete
      // (prevents history scrubbing); a future report flow can hide instead.
      allow delete: if isAdmin();
    }

    // ═════════════════════════════════════════════════════════
    // TOURS COLLECTION
    // ═════════════════════════════════════════════════════════
    match /tours/{tourId} {
      // Only buyer and seller involved can read tours
      allow read: if isAuthenticated() &&
        (request.auth.uid == resource.data.buyerId ||
         request.auth.uid == resource.data.sellerId);

      // Buyers can create tour requests
      allow create: if isAuthenticated() && !isSuspended() &&
        request.resource.data.buyerId == request.auth.uid &&
        request.resource.data.keys().hasAll([
          'propertyId', 'propertyTitle', 'propertyImage', 'buyerId',
          'buyerName', 'sellerId', 'sellerName', 'status', 'datetime',
          'duration', 'attendees', 'notes', 'reminderSent',
          'createdAt', 'updatedAt'
        ]) &&
        request.resource.data.status == 'pending';

      // Buyer and seller can update status (confirm/decline/cancel)
      allow update: if isAuthenticated() &&
        (request.auth.uid == resource.data.buyerId ||
         request.auth.uid == resource.data.sellerId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'confirmedAt', 'canceledBy', 'cancelReason',
          'reminderSent', 'updatedAt', 'datetime'
        ]);

      allow delete: if false;
    }

    // ═════════════════════════════════════════════════════════
    // TOUR AVAILABILITY COLLECTION
    // ═════════════════════════════════════════════════════════
    match /tourAvailability/{sellerId} {
      // Anyone authenticated can read availability
      allow read: if isAuthenticated();

      // Only the seller can set their availability
      allow create, update: if isOwner(sellerId);

      allow delete: if false;
    }

    // ═════════════════════════════════════════════════════════
    // NEIGHBORHOOD DATA COLLECTION
    // ═════════════════════════════════════════════════════════
    // Two kinds of docs live here:
    //  - Rich neighborhood profiles keyed city_state_zip: written only by
    //    Cloud Functions/Admin (weekly scheduled job) — admin-write.
    //  - Overpass insights cache keyed "lat_lng" (3-decimal grid): written by
    //    any authenticated user on first visit (validated shape below) so
    //    repeat views skip the external API. Reads stay authenticated.
    match /neighborhood_data/{docId} {
      // Anyone authenticated can read neighborhood data
      allow read: if isAuthenticated();

      // Insights-cache writes: doc id must be the lat/lng key, shape-locked,
      // bounded scores, and doc id fields must match the payload grid cell.
      allow create, update: if isAdmin() || (
        isAuthenticated() &&
        docId.matches('^-?[0-9]+[.][0-9]{3}[_]-?[0-9]+[.][0-9]{3}$') &&
        request.resource.data.keys().hasOnly(
          ['walkScore', 'transitScore', 'schools', 'fetchedAt']
        ) &&
        request.resource.data.walkScore is number &&
        request.resource.data.walkScore >= 0 &&
        request.resource.data.walkScore <= 100 &&
        request.resource.data.transitScore is number &&
        request.resource.data.transitScore >= 0 &&
        request.resource.data.transitScore <= 100 &&
        request.resource.data.schools is list &&
        request.resource.data.schools.size() <= 5 &&
        request.resource.data.fetchedAt == request.time
      );
    }

    // ═════════════════════════════════════════════════════════
    // EXPORTS COLLECTION (GDPR data export)
    // ═════════════════════════════════════════════════════════
    match /exports/{exportId} {
      // Users can only read their own exports
      allow read: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;

      // Users can create their own export requests
      allow create: if isAuthenticated() && !isSuspended() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.keys().hasAll([
          'userId', 'status', 'createdAt', 'expiresAt'
        ]) &&
        request.resource.data.status == 'pending';

      // Only the requesting user or admins can update
      allow update: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());

      allow delete: if false;
    }

    // ═════════════════════════════════════════════════════════
    // ANALYTICS COLLECTION (admin dashboard metrics)
    // ═════════════════════════════════════════════════════════
    match /analytics/{date} {
      // Admins can read/write analytics
      allow read, write: if isAdmin();
    }

    // ═════════════════════════════════════════════════════════
    // DEFAULT: DENY ALL OTHER PATHS
    // ═════════════════════════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
