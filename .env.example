# Copy this file to .env and fill in your values.
# Firebase (web SDK v9) - https://console.firebase.google.com
EXPO_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
EXPO_PUBLIC_FIREBASE_APP_ID=1:your-app-id
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Cloudinary (media uploads) - https://console.cloudinary.com
# Image/video uploads are unsigned client-side; deletes go through the
# signed deleteCloudinaryAsset Cloud Function (CLOUDINARY_API_KEY/_SECRET
# are server-side only — set them with `firebase functions:secrets:set`).
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
EXPO_PUBLIC_CLOUDINARY_VIDEO_PRESET=

# Google Maps (native iOS/Android builds, injected via app.config.js)
EXPO_PUBLIC_GOOGLE_MAPS_IOS_API_KEY=your-ios-maps-key
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=your-android-maps-key
# JS/web Maps key (Places lookups in src/services/neighborhoodService.ts).
# On Android this is NOT the same key as the native one above: the native key is
# injected into the manifest, this one is used for HTTP Places requests.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-web-places-key

# NOTE: this file is NOT uploaded to EAS Build (.env is gitignored).
# Before building in the cloud, push these values to EAS once per environment
# (eas env:push rejects empty values, so filter your .env first):
#   grep -E "^EXPO_PUBLIC_[A-Z0-9_]+=.+" .env > .env.eas-push
#   eas env:push preview --path .env.eas-push --force
#   eas env:push production --path .env.eas-push --force
# The five required Firebase values below make the app throw on startup when
# missing in a release build (src/utils/env.ts), so the build must see them.

# Google Sign-In - Firebase console > Authentication > Sign-in method > Google.
# Web sign-in uses the Firebase popup (no client IDs needed). These are used
# by the native (iOS/Android) expo-auth-session flow.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-google-android-client-id

# Sentry (optional) - https://sentry.io. Leave empty to disable error reporting.
# Create a project, copy its DSN: Settings > Client Keys (DSN)
EXPO_PUBLIC_SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxx@sentry.io/0000000

# App Check (web) - https://console.firebase.google.com > App Check
# Register a reCAPTCHA site key for the web app in App Check, then enable
# enforcement per API (Firestore/Storage). Native builds need a dev build with
# @react-native-firebase/app-check (Play Integrity / App Attest).
EXPO_PUBLIC_RECAPTCHA_SITE_KEY=
# Optional: use reCAPTCHA Enterprise instead of v3 (higher-cost SKU).
EXPO_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=
# Local dev only: a fixed App Check debug token. Generate/register it with
#   firebase appcheck:debugtokens:create <token> --project <project> --app <web-app-id>
# or copy the auto-generated token printed by the SDK on first run.
# Leave empty to let the SDK generate and persist one. Ignored in production.
EXPO_PUBLIC_APPCHECK_DEBUG_TOKEN=

# Feature flags (optional, default OFF unless noted)
# Record performance metric samples as Sentry breadcrumbs (needs a DSN).
EXPO_PUBLIC_ENABLE_PERF_SPANS=false
# Log performance metrics to the console in development (default ON).
EXPO_PUBLIC_ENABLE_DEV_METRICS_LOG=true
# Count Firestore read/write usage for the admin analytics screen (default OFF).
EXPO_PUBLIC_METRICS_ENABLED=false
# Daily per-user Firestore read cap when metrics are enabled (default 5000).
EXPO_PUBLIC_READ_BUDGET=5000

# Unit system for currency/area formatting (src/utils/format.ts).
# 'imperial' (default): $ + sqft · 'metric': KSh + m²
EXPO_PUBLIC_UNIT_SYSTEM=imperial

# Route Firebase callable functions (AI assistant, AI search) to the local
# emulator in dev: `firebase emulators:start --only functions,auth`.
# Use your LAN IP instead of localhost when testing from a physical device.
EXPO_PUBLIC_FUNCTIONS_EMULATOR=false