# dependencies
node_modules/

# Expo
.expo/
dist/
dist-test/
web-build/
expo-env.d.ts

# NOTE: android/ and ios/ are generated by Expo Prebuild (CNG) and must not be
# committed — but they are deliberately NOT listed here. EAS Build's Android job
# fails with `ENOENT .../android/gradlew` ("Fix gradlew" phase) when those ignore
# rules are present in a repo that ever committed the native folders.
# Keep native folders out of the repo instead of ignoring them.

# Native build artifacts
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Environment variables (never commit secrets)
.env
.env.local
.env.*.local
.env.development
.env.production
.env.staging
.env.*
!.env.example
!functions/.env.example

# Firebase CLI local cache (file hashes for hosting deploys)
.firebase/

# Firebase Cloud Functions (own .gitignore in functions/)
functions/lib/

# Misc
.DS_Store
npm-debug.*
yarn-debug.*
yarn-error.*

# Firebase emulator logs (regenerated on every local run — never commit)
firestore-debug.log
firebase-debug.log
firebase-debug.pid
ui-debug.log

# Implementations
implementations/