{
  "expo": {
    "name": "House Hunter",
    "slug": "house-hunter",
    "scheme": "househunter",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#1B6EF3"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "web": {
      "bundler": "metro"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.househunter.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "package": "com.househunter.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow House Hunter to access your location."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow House Hunter to access your photos.",
          "cameraPermission": "Allow House Hunter to access your camera."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1B6EF3"
        }
      ],
      "expo-font",
      [
        "@sentry/react-native",
        {
          "organization": "TODO_YOUR_SENTRY_ORG",
          "project": "TODO_YOUR_SENTRY_PROJECT"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "e316931e-5844-4bb9-a7f4-bcfcadb40440"
      }
    },
    "owner": "johnbundi"
  }
}
