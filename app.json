{
  "expo": {
    "name": "Ascend Hunters",
    "slug": "house-hunter",
    "scheme": "househunter",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "web": {
      "bundler": "metro"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.househunter.app"
    },
    "android": {
      "package": "com.househunter.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#061023"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/loader-anime.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "backgroundColor": "#061023"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Ascend Hunters to access your location."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Ascend Hunters to access your photos.",
          "cameraPermission": "Allow Ascend Hunters to access your camera."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#22C55E"
        }
      ],
      "expo-font",
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "e316931e-5844-4bb9-a7f4-bcfcadb40440"
      }
    },
    "owner": "johnbundi"
  }
}
